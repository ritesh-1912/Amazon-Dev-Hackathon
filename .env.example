# Server Configuration
PORT=3001
NODE_ENV=development
DB_PATH=./data/campus_ops.db

# AWS Bedrock Configuration (Phase 3)
# Required: set your project's assigned region (no default fallback; e.g. ap-southeast-2 or us-east-1)
AWS_REGION=ap-southeast-2

# Primary / Recommended Authentication Method:
AWS_BEARER_TOKEN_BEDROCK=

# Fallback Authentication Method (IAM access keys):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Foundation Model ID (Claude 3 Haiku default)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
